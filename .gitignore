/target
.DS_Store
# Raw audio level files and their side files (up to 0.5 MB each); audio-levels.ps1 recreates them from the rip.
corpus/owner/*/*/audio-levels-*/*.txt

# Subtitle text and bitmaps stay in the tuning dataset (decision D16).
*.ocr.jsonl
corpus/owner/**/*.mks
# ocrs's text of the same frames (scripts/phase0/ocrs-trial.ps1) is subtitle text too.
ocrs-s*.jsonl

# The ocrs trial crate: its models are CC-BY-SA-4.0 downloads, never committed; a local build's target folder.
experiments/ocrs-trial/models/
experiments/ocrs-trial/target/
